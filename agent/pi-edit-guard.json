{
  "commands": {
    "prettier": ["prettier", "--write", "--ignore-unknown"],
    "gofmt": ["gofmt", "-w"],
    "rustfmt": ["rustfmt", "--edition", "2021"],
    "clang-format": ["clang-format", "-i"]
  },
  "filetypes": {
    "*.ts": "prettier",
    "*.tsx": "prettier",
    "*.js": "prettier",
    "*.jsx": "prettier",
    "*.mjs": "prettier",
    "*.cjs": "prettier",
    "*.mts": "prettier",
    "*.cts": "prettier",
    "*.json": "prettier",
    "*.jsonc": "prettier",
    "*.json5": "prettier",
    "*.css": "prettier",
    "*.scss": "prettier",
    "*.less": "prettier",
    "*.html": "prettier",
    "*.vue": "prettier",
    "*.svelte": "prettier",
    "*.xml": "prettier",
    "*.md": "prettier",
    "*.mdx": "prettier",
    "*.yml": "prettier",
    "*.yaml": "prettier",
    "*.toml": "prettier",
    "*.go": "gofmt",
    "*.rs": "rustfmt",
    "*.c": "clang-format",
    "*.h": "clang-format",
    "*.cpp": "clang-format",
    "*.hpp": "clang-format",
    "*.cc": "clang-format",
    "*.cxx": "clang-format",
    "*.m": "clang-format",
    "*.mm": "clang-format",
    "*.java": "clang-format",
    "*.cs": "clang-format",
    "*.proto": "clang-format"
  }
}
